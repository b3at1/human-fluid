APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
# Local development also accepts loopback aliases on ports 5173 and 8000.
# For forwarding/hosting, use the browser-facing origin and restart the server.
# Compose overrides PUBLIC_ORIGIN with this container-facing origin.
CONTAINER_PUBLIC_ORIGIN=http://localhost:8000
# Absolute path recommended; default is <repository>/data/human-fluid.db
# DATABASE_URL=sqlite:////absolute/path/to/data/human-fluid.db
COOKIE_SECURE=false
SESSION_DAYS=90
AI_PROVIDER=disabled
AI_ENABLED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Enable only after verifying provider cap semantics and byte-level token bounds.
AI_CAP_VERIFIED=false
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=1500
AI_GRANT_REQUESTS_PER_MINUTE=4
AI_GRANT_REQUESTS_PER_DAY=30
AI_GLOBAL_REQUESTS_PER_DAY=100
AI_GLOBAL_TOKENS_PER_DAY=750000
AI_GRANT_TOKENS_PER_DAY=225000
